{
  "name": "video-compression-analyzer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-ffmpeg-core.mjs",
    "predev": "node scripts/copy-ffmpeg-core.mjs",
    "dev": "next dev --webpack",
    "prebuild": "node scripts/copy-ffmpeg-core.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "desktop:dev": "concurrently -k -n next,electron \"next dev --webpack -p 3210\" \"wait-on http://localhost:3210 && electron . --dev-url=http://localhost:3210\"",
    "desktop:start": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "desktop:dist:win": "npm run build && electron-builder --win",
    "desktop:dist:mac": "npm run build && electron-builder --mac",
    "desktop:dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.1.6",
    "framer-motion": "^12.34.4",
    "lucide-react": "^0.576.0",
    "mediabunny": "^1.61.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-dropzone": "^15.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "wait-on": "^9.5.1",
    "zustand": "^5.0.11"
  },
  "description": "Browser + desktop video compression analyzer and converter (WebCodecs, FFmpeg.wasm, native FFmpeg)",
  "main": "electron/main.cjs",
  "author": "MihrimatriX",
  "build": {
    "appId": "com.mihrimatrix.video-compression-analyzer",
    "productName": "Video Compression Analyzer",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "electron/build"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json",
      "!out/ffmpeg/**",
      "!**/*.map",
      "!node_modules/ffprobe-static/bin/**",
      "node_modules/ffprobe-static/bin/${platform}/${arch}/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "MihrimatriX"
    }
  }
}
